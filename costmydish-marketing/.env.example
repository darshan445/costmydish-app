# Site URL is fixed to https://www.costmydish.com in lib/site.js (canonical host).

# App Store Connect provider token — makes `ct=` campaign links show in
# App Store Connect → Analytics → Acquisition → Campaigns
NEXT_PUBLIC_APPLE_PROVIDER_TOKEN=

# Google Search Console HTML tag verification (optional)
# Get content value from GSC → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact emails shown on the marketing site
NEXT_PUBLIC_SUPPORT_EMAIL=support@costmydish.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@costmydish.com

# Supabase (auth pages: /confirm, /reset-password, /update-password)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
